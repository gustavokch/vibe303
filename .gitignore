# Rust
target/
Cargo.lock.bak

# Redundant export sidecar (data is in the main weights JSON's "meta" key)
plugin/weights/*.meta.json

# Regenerable artifacts
data/
checkpoints/
runs/
*.pth
*.npz
*.wav
*.flac

# Allow committed reference WAVs (Git LFS) — re-include after the broad exclude
!tests/regression/refs/*.wav
# Allow committed test fixtures (small, intentional)
!tests/fixtures/*.wav
!tests/fixtures/**/*.wav

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
